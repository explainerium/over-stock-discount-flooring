# ---------------------------------------------------------------------------
# Overstock Discount Flooring — environment
# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# DATABASE_URL is the POOLED connection — used by the running app.
# DIRECT_URL bypasses the pooler and is used by `prisma migrate`.
# Serverless gives one connection per invocation, so the app must go through
# a pooler or it exhausts max_connections under trivial load.
#
# On a hosted database, say sslmode=verify-full rather than sslmode=require.
# They behave identically today — pg treats require as verify-full — but pg 9
# will give require its weaker libpq meaning, and until then the driver prints
# a warning on every connection that Next surfaces in the dev overlay as an
# error. Being explicit silences it and keeps the stricter behaviour after the
# change. A local Postgres with no TLS uses sslmode=disable.
DATABASE_URL="postgresql://user:password@host:5432/odf?schema=public&pgbouncer=true&sslmode=verify-full"
DIRECT_URL="postgresql://user:password@host:5432/odf?schema=public&sslmode=verify-full"

# Connections held per process.
#
# With a Prisma 7 driver adapter the connection string is handed straight to the
# "pg" driver, so Prisma's own "?connection_limit=" parameter is ignored. The
# pool is bounded by this variable instead — see src/server/db/client.ts.
#
# Set this to 1 when running against a local "npx prisma dev" server. That proxy
# reports max_connections of 100 but terminates the SECOND concurrent client, so
# any page issuing queries in parallel — the home page does three — fails with
# "Connection terminated unexpectedly". A pool of 1 makes pg queue the queries
# rather than open a second connection.
#
# On managed Postgres (Neon, Supabase) this constraint does not exist; 3 is a
# sensible per-process figure for serverless, where each invocation has its own.
DATABASE_POOL_SIZE="3"

# --- App -------------------------------------------------------------------
SITE_URL="http://localhost:3000"

# --- Auth ------------------------------------------------------------------
# bcrypt work factor. 12 is the floor for production.
AUTH_BCRYPT_ROUNDS="12"
# How long a dealer session stays valid, in days.
AUTH_SESSION_DAYS="30"

# --- Cron ------------------------------------------------------------------
# Shared secret for /api/cron/[job]. The scheduled caller sends it as a header;
# the route rejects anything else. Vercel Cron calls the URL today, system cron
# calls the same URL on a VPS later — only the caller changes.
CRON_SECRET=""

# --- Object storage (S3-compatible: Cloudflare R2, S3, ...) ----------------
# S3-compatible rather than a host-specific blob product, so moving off Vercel
# is a config change and not a migration.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL images are served from — must match next.config.ts remotePatterns.
MEDIA_URL="http://localhost:3000"

# --- Analytics -------------------------------------------------------------
# GA4 measurement ID. The tag loads only in production and only when this is
# set, so clicking around localhost never shows up in the client numbers.
# The current site has NO analytics of any kind. Install this before cutover
# or there is no baseline to compare the relaunch against.
GA_MEASUREMENT_ID=""

# --- Transactional email ---------------------------------------------------
# NOTE: cannot send "from" a gmail.com address. Needs a mailbox on the business
# domain plus SPF, DKIM and DMARC at the registrar. See project-plan.md §7.
EMAIL_PROVIDER="postmark"
EMAIL_API_KEY=""
EMAIL_FROM="orders@overstockdiscountflooring.com"
# Standing CC recipients on order mail, comma-separated.
EMAIL_ORDER_CC=""

# --- SMS / owner alerts (optional — pending client sign-off) ---------------
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
OWNER_ALERT_NUMBER=""

# --- QuickBooks Online -----------------------------------------------------
# Private app against the client's own company file.
# Refresh tokens expire after 100 days — the health check job watches for it.
QBO_CLIENT_ID=""
QBO_CLIENT_SECRET=""
QBO_REDIRECT_URI="http://localhost:3000/api/qbo/callback"
QBO_ENVIRONMENT="sandbox"

